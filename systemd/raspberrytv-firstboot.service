[Unit]
Description=Install RaspberryTV on first boot
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/raspberrytv-bootstrap/scripts/install.sh

[Service]
Type=oneshot
ExecStart=/opt/raspberrytv-bootstrap/scripts/install.sh --first-boot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
