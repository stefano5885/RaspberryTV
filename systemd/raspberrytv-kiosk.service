[Unit]
Description=RaspberryTV X11 browser kiosk
After=raspberrytv-web.service systemd-user-sessions.service network-online.target
Requires=raspberrytv-web.service
Wants=network-online.target
Conflicts=getty@tty7.service display-manager.service

[Service]
Type=simple
User=raspberrytv
Group=raspberrytv
WorkingDirectory=/var/lib/raspberrytv
Environment=HOME=/home/raspberrytv
ExecStart=/bin/sh /opt/raspberrytv/current/scripts/start-x-kiosk.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=12

[Install]
WantedBy=graphical.target
